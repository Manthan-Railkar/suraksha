{
  "version": 1,
  "author": "Suraksha Project",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-slide-switch",
      "id": "door_switch",
      "top": -80,
      "left": -120,
      "attrs": { "label": "Door (CLOSED=Right, OPEN=Left)" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "vib_button",
      "top": -80,
      "left": 120,
      "attrs": { "color": "orange", "label": "Vibration / Knock (Press)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_vib_pulldown",
      "top": -40,
      "left": 180,
      "attrs": { "value": "10000" }
    },
    {
      "type": "wokwi-led",
      "id": "led_armed",
      "top": 120,
      "left": 120,
      "attrs": { "color": "green", "label": "ARMED" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_armed",
      "top": 160,
      "left": 120,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alarm",
      "top": 200,
      "left": 120,
      "attrs": { "color": "red", "label": "ALARM" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_alarm",
      "top": 240,
      "left": 120,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 120,
      "left": -140,
      "attrs": { "label": "Buzzer" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "uv_sensor",
      "top": 200,
      "left": -140,
      "attrs": { "label": "UV Sensor (Analog 0-3.3V)" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "door_switch:2", "esp:32", "green", [ "v0" ] ],
    [ "door_switch:3", "esp:GND.1", "black", [ "v0" ] ],

    [ "vib_button:1.1", "esp:3V3", "red", [ "v0" ] ],
    [ "vib_button:2.1", "esp:23", "orange", [ "v0" ] ],
    [ "vib_button:2.1", "r_vib_pulldown:1", "orange", [ "v0" ] ],
    [ "r_vib_pulldown:2", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:27", "led_armed:A", "green", [ "v0" ] ],
    [ "led_armed:C", "r_armed:1", "green", [ "v0" ] ],
    [ "r_armed:2", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:14", "led_alarm:A", "red", [ "v0" ] ],
    [ "led_alarm:C", "r_alarm:1", "red", [ "v0" ] ],
    [ "r_alarm:2", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:15", "buzzer:2", "purple", [ "v0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "v0" ] ],

    [ "uv_sensor:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "uv_sensor:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "uv_sensor:SIG", "esp:35", "blue", [ "v0" ] ]
  ],
  "dependencies": {}
}
